# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/appfinanza

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Anthropic (AI Engine)
ANTHROPIC_API_KEY=your_anthropic_api_key

# GoHighLevel CRM (API V2)
# Auth: OAuth2 or Private Integration Token
# Base URL: https://services.leadconnectorhq.com
# Rate limit: 100 req/10s per resource, 200k/day
# Required header: Version: 2021-07-28
# Endpoints used:
#   GET  /opportunities/search         — pipeline deals
#   POST /contacts/search              — advanced contact search
#   GET  /conversations/search         — conversations
#   GET  /calendars/events             — calendar events
#   GET  /opportunities/pipelines      — pipeline metadata
GHL_API_URL=https://services.leadconnectorhq.com
GHL_API_KEY=your_ghl_api_key_or_oauth_token
GHL_LOCATION_ID=your_ghl_location_id

# HubSpot CRM
# Auth: Private App token or OAuth
# Rate limit: 100 req/10s (private apps)
# Scopes required:
#   crm.objects.read           — for deals, contacts, tickets search
#   analytics.read             — for Analytics API traffic/session reports
#   crm.schemas.read           — for pipeline metadata (optional)
# Endpoints used:
#   POST /crm/v3/objects/{type}/search  — CRM search with filters
#   GET  /crm/v3/pipelines/{type}       — pipeline stage metadata
#   GET  /analytics/v2/reports/{b}/{p}  — pre-aggregated analytics (Marketing Hub Enterprise)
HUBSPOT_API_URL=https://api.hubapi.com
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token
